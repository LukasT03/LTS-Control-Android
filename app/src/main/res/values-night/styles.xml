<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window in dark mode, otherwise its white shows as a thin edge in the app switcher. -->
    <style name="Theme.LTSControl.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.LTSControl" parent="Theme.LTSControl.Base" />
</resources>
